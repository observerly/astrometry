{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**/src/**/*.ts",
      "**/src/**/*.tsx",
      "**/src/**/*.js",
      "**/src/**/*.jsx",
      "**/lib/**/*.ts",
      "**/lib/**/*.tsx",
      "**/lib/**/*.js",
      "**/lib/**/*.jsx",
      "**/tests/**/*.ts",
      "biome.json",
      "package.json",
      "tsconfig.json",
      "vite.config.ts",
      "!**/node_modules",
      "!**/dist",
      "!**/bin"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "includes": ["**", "!**/dist", "!**/node_modules"]
  },
  "linter": {
    "enabled": true,
    "includes": ["**", "!**/dist", "!**/node_modules"],
    "rules": {
      "preset": "recommended",
      "style": {
        "noParameterAssign": {
          "level": "info"
        }
      },
      "suspicious": {
        "noApproximativeNumericConstant": {
          "level": "info"
        },
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": true
          }
        }
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["**/tests/**/*.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noAdjacentSpacesInRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.json"],
      "formatter": {
        "indentWidth": 2
      }
    }
  ],
  "javascript": {
    "formatter": {
      "enabled": true,
      "lineWidth": 100,
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "indentWidth": 2,
      "indentStyle": "space",
      "arrowParentheses": "asNeeded",
      "quoteStyle": "single"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentWidth": 2,
      "indentStyle": "space"
    },
    "linter": {
      "enabled": true
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git"
  }
}
